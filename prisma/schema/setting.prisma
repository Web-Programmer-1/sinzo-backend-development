model Setting {
  id           String   @id @default(uuid())
  logo         String?

  bkashNumber  String?  // bKash send money number
  nagadNumber  String?  // Nagad send money number

  createdAt    DateTime @default(now())

}


model Banner {
  id         String   @id @default(uuid())
  image      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



model PaymentSetting {
  id           String   @id @default(uuid())

  bkashNumber  String?
  nagadNumber  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}